<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageId>pengdows.crud.analyzers</PackageId>
        <Description>Roslyn analyzers for correct pengdows.crud usage.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Supplied by the compiler at build time; not a dependency of consumers (REV-066). -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- Release tracking for the PGC rules (RS2008); add each new rule to Unshipped. -->
    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <!-- The code fixes live in their own assembly (they need Workspaces, RS1038); built first and
         packed alongside the analyzers. -->
    <ItemGroup>
        <ProjectReference Include="..\pengdows.crud.analyzers.codefixes\pengdows.crud.analyzers.codefixes.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\pengdows.crud.analyzers.codefixes\bin\$(Configuration)\netstandard2.0\pengdows.crud.analyzers.codefixes.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs" />
        <!-- build/{PackageId}.props is auto-imported by any project referencing this package —
             this is how PGC029's opt-in PengdowsMultiTenancy property becomes CompilerVisible in
             a consuming project. See the file's own comments for the enablement contract. -->
        <None Include="build/pengdows.crud.analyzers.props"
              Pack="true"
              PackagePath="build/pengdows.crud.analyzers.props" />
    </ItemGroup>
</Project>
