<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Code fixes, separate from the analyzers: they need Microsoft.CodeAnalysis.Workspaces, which the
      compiler doesn't load for an analyzer assembly (RS1038). Packed into the pengdows.crud.analyzers
      package by pengdows.crud.analyzers.csproj.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" PrivateAssets="all" />
    </ItemGroup>
</Project>
