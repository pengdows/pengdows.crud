<Project>
    <!--
      Local developer overrides: copy Directory.Build.user.props.template to
      Directory.Build.user.props (gitignored) and set properties there instead of
      editing this file.  Alternatively, pass -p:SkipVerifyNoVendor=true on the
      dotnet command line.
    -->
    <Import Project="Directory.Build.user.props" Condition="Exists('Directory.Build.user.props')" />

    <PropertyGroup>
        <!--
          Skip the "no vendor" verification step that checks for vendored dependencies.
          Set this to true when the verify-novendor tool or its .NET 8 dependencies are unavailable
          (e.g., early local development or machines that cannot install .NET 8). Set to false on CI
          so that the verification step always runs and catches vendored files.
          Override locally via Directory.Build.user.props or -p:SkipVerifyNoVendor=true.
        -->
        <SkipVerifyNoVendor Condition="'$(SkipVerifyNoVendor)' == ''">true</SkipVerifyNoVendor>
        <!--
          Skip public API/interface validation during the build.
          Set this to true for local experimentation or when InterfaceApiCheck cannot run.
          Keep it false on release/CI so interface-breaking changes are validated.
          Override locally via Directory.Build.user.props or -p:SkipInterfaceValidation=true.
        -->
        <SkipInterfaceValidation Condition="'$(SkipInterfaceValidation)' == ''">false</SkipInterfaceValidation>
        <!--
          NuGet vulnerability-audit warnings (NU1901-NU1904) stay warnings under TreatWarningsAsErrors:
          an advisory published against a dependency must be visible, not break every build (REV-066).
        -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
        <!-- Lets the .editorconfig rule IDE0011 (required braces, review policy 4F) report during the build. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <VersionPrefix>2.0.6</VersionPrefix>
        <Version>$(VersionPrefix)</Version>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>
    </PropertyGroup>

    <!--
      SemVer guard for the 2.0.x line: `dotnet pack` runs ApiCompat against the last published
      2.0.x package and fails on any binary-breaking change (removed members, new non-default
      interface members, etc.). Bump the baseline after each 2.0.x release ships.
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'pengdows.crud' Or '$(MSBuildProjectName)' == 'pengdows.crud.abstractions' Or '$(MSBuildProjectName)' == 'pengdows.crud.fakeDb'">
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>2.0.5</PackageValidationBaselineVersion>
    </PropertyGroup>

    <!--
      Public-API guard: every public or protected member of the three shipped packages must be listed in
      PublicAPI.Shipped.txt (seeded from 2.0.5) or PublicAPI.Unshipped.txt (added since, each with a reason in
      docs/FUTURE_WORK.md). A new public member fails the build (RS0016) until it is declared, so public API
      cannot grow by accident. See REVIEW_POLICY.md 4D.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'pengdows.crud' Or '$(MSBuildProjectName)' == 'pengdows.crud.abstractions' Or '$(MSBuildProjectName)' == 'pengdows.crud.fakeDb'">
        <!-- RS0026/RS0027 (overload shape) and RS0041 (oblivious nullability) judge designs that already
             shipped; the guard is for what is declared (RS0016/RS0017), not for those. -->
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt"/>
    </ItemGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'pengdows.crud' Or '$(MSBuildProjectName)' == 'pengdows.crud.abstractions' Or '$(MSBuildProjectName)' == 'pengdows.crud.fakeDb'">
        <NoWarn>$(NoWarn);RS0026;RS0027;RS0041</NoWarn>
    </PropertyGroup>
</Project>
