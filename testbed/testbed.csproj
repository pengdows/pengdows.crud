<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>testbed</RootNamespace>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AdoNetCore.AseClient" Version="0.19.2"/>
        <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="8.0.0.500"/>
        <PackageReference Include="Informix.Net.Core-lnx" Version="4.1501.2.2026"/>
        <PackageReference Include="InterBaseSql.Data.InterBaseClient" Version="10.0.3"/>
        <PackageReference Include="Sap.Data.Hana.Net.v8.0" Version="2.29.27"/>
        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="DuckDB.NET.Data.Full" Version="1.3.2"/>
        <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3"/>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.4"/>
        <PackageReference Include="MySql.Data" Version="9.3.0"/>
        <PackageReference Include="Npgsql" Version="9.0.3"/>
        <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.8.0"/>
        <PackageReference Include="Snowflake.Data" Version="4.*"/>
        <PackageReference Include="System.Data.OleDb" Version="8.0.1"/>
        <PackageReference Include="Testcontainers" Version="4.4.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\pengdows.crud\pengdows.crud.csproj"/>
        <ProjectReference Include="..\pengdows.stormgate\pengdows.stormgate.csproj"/>
    </ItemGroup>

    <!--
      pengdows.flatfile is not published to NuGet yet, so the testbed builds it from a sibling
      checkout (the same layout 3.0 uses: ../../pengdows.flatfile next to this repository). Only the
      testbed and pengdows.crud.IntegrationTests reference it; the shipped packages never do.
      Override PengdowsFlatFileProject (e.g. -p:PengdowsFlatFileProject=/abs/path/pengdows.flatfile.csproj)
      when building from a worktree. Without the sibling checkout, FlatFile is left out of the build
      and the testbed prints a warning instead of silently passing.
    -->
    <PropertyGroup>
        <PengdowsFlatFileProject Condition="'$(PengdowsFlatFileProject)' == ''">$(MSBuildThisFileDirectory)..\..\pengdows.flatfile\pengdows.flatfile\pengdows.flatfile.csproj</PengdowsFlatFileProject>
        <DefineConstants Condition="Exists('$(PengdowsFlatFileProject)')">$(DefineConstants);PENGDOWS_FLATFILE</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(PengdowsFlatFileProject)')">
        <ProjectReference Include="$(PengdowsFlatFileProject)"/>
    </ItemGroup>

    <ItemGroup Condition="!Exists('$(PengdowsFlatFileProject)')">
        <Compile Remove="FlatFile\**"/>
    </ItemGroup>

</Project>
