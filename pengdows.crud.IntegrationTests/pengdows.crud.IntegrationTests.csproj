<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="Xunit.SkippableFact" Version="1.4.13"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql" Version="9.0.3"/>
        <PackageReference Include="Testcontainers" Version="4.4.0"/>
        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\pengdows.crud\pengdows.crud.csproj"/>
        <ProjectReference Include="..\pengdows.crud.fakeDb\pengdows.crud.fakeDb.csproj"/>
        <ProjectReference Include="..\testbed\testbed.csproj"/>
    </ItemGroup>

    <!-- One Db2 native-library bootstrap, shared with the testbed: dotnet test never runs testbed's Program.cs,
         so the file's module initializer registers the resolver when this assembly loads. -->
    <ItemGroup>
        <Compile Include="..\testbed\Db2\Db2NativeLibraryBootstrap.cs" Link="Infrastructure\Db2NativeLibraryBootstrap.cs"/>
    </ItemGroup>

    <!-- pengdows.flatfile (NuGet) arrives through testbed; PENGDOWS_FLATFILE gates the
         FlatFile-specific test code, as in testbed/testbed.csproj. -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);PENGDOWS_FLATFILE</DefineConstants>
    </PropertyGroup>

</Project>
